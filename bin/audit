#!/usr/bin/env bash
# Gathers the facts the weekly drift audit judges into one JSON document.
#
# Why this exists: nothing on a Mac reports, in one place, how far the tools an
# agent session depends on have drifted: hand-installed CLIs behind their
# releases, npm globals behind npm, the two forks behind their upstreams, and
# policy paths that no longer resolve. This script collects exactly that and
# nothing else: it is read-only, never installs, removes or updates anything,
# and writes only to stdout. bin/audit-page turns the JSON into a page.
#
# Sections of the output (see tests/fixtures/audit for a full example):
#   doctor    bin/doctor's output and exit status
#   versions  installed against latest for no-mistakes and treehouse (GitHub
#             releases, with the latest release's notes), claude-swap (PyPI),
#             the claude-code@latest and codex casks (brew), every npm global
#             (npm), and cursor-agent (installed only: it has no release feed)
#   forks     commits the dotfiles and firstmate forks lack from upstream, and
#             the date they last shared a commit
#   policy    every ~/ path and https link in the global agent policy, and
#             whether it resolves
#   errors    the sources that did not answer, one line each
#
# Every live input can be replaced by a file for tests:
#   AUDIT_FIXTURES  a directory; each source below is read from the file of that
#                   name in it instead of running its command, and
#                   optional <source>.status holds the source's exit code
#   AUDIT_NOW       epoch seconds to stamp the document with
#   AUDIT_POLICY    the policy file to check (default home/global-agents.md)
#   AUDIT_HOME      what ~ expands to in policy paths (default $HOME)
#
# Exit 0 when every source answered, 1 when some did not (the JSON is still
# complete, with nulls and an errors list), 2 when the output cannot be built.
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
  exit 0
fi

command -v jq >/dev/null || { echo "audit: jq is not on PATH" >&2; exit 2; }
here="$(cd "$(dirname "$0")" && pwd)"
fx="${AUDIT_FIXTURES:-}"
now="${AUDIT_NOW:-$(date +%s)}"
policy="${AUDIT_POLICY:-$here/../home/global-agents.md}"
home="${AUDIT_HOME:-$HOME}"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
: >"$tmp/versions"; : >"$tmp/forks"; : >"$tmp/policy"; : >"$tmp/errors"

# Every source is "source <name> <command...>": the command's stdout, or the
# fixture file of that name. Prints nothing and returns 1 when the command
# fails or the fixture is missing, so callers can record the gap.
source_() {
  local name="$1"; shift
  if [ -n "$fx" ]; then
    cat "$fx/$name" 2>/dev/null || return $?
    if [ -r "$fx/$name.status" ]; then return "$(cat "$fx/$name.status")"; fi
  else
    "$@" 2>/dev/null
  fi
}
gap() { printf '%s\n' "$1" | jq -R . >>"$tmp/errors"; }
npm_outdated() {
  local status=0
  source_ npm-outdated npm outdated -g --json || status=$?
  [ "$status" -le 1 ]
}
first_version() { grep -oE 'v?[0-9]+(\.[0-9]+)+' | head -n1; }
release_date() { sed -E 's/\.[0-9]+Z$/Z/'; } # PyPI stamps fractional seconds; jq's fromdateiso8601 does not take them

# $1 = name, $2 = kind, $3 = installed, $4 = latest, $5 = released, $6 = notes,
# $7 = notes url, $8 = update command. Empty strings become null.
version() {
  jq -nc --arg name "$1" --arg kind "$2" --arg installed "$3" --arg latest "$4" \
    --arg released "$5" --arg notes "$6" --arg notes_url "$7" --arg update "$8" \
    '{name: $name, kind: $kind} + ({installed: $installed, latest: $latest, released: $released,
      notes: $notes, notes_url: $notes_url, update: $update} | map_values(if . == "" then null else . end))' \
    >>"$tmp/versions"
}

# $1 = name, $2 = source name, $3 = owner/repo, $4 = version command, $5 = update command
github_release() {
  local installed="" latest="" released="" notes="" url="" json
  installed="$(source_ "$2-version" "$4" --version | first_version)" || gap "$2-version: $4 --version gave nothing"
  if json="$(source_ "$2-release" gh api "repos/$3/releases/latest")" && [ -n "$json" ]; then
    latest="$(jq -r '.tag_name // ""' <<<"$json")"
    released="$(jq -r '.published_at // ""' <<<"$json")"
    notes="$(jq -r '.body // ""' <<<"$json")"
    url="$(jq -r '.html_url // ""' <<<"$json")"
  else
    gap "$2-release: no answer from the GitHub releases API for $3"
  fi
  version "$1" github "$installed" "$latest" "$released" "$notes" "$url" "$5"
}

# $1 = name, $2 = owner/repo of the upstream, $3 = fork owner
fork() {
  local json
  if json="$(source_ "compare-$1" gh api "repos/$2/compare/$3:main...${2%%/*}:main")" && [ -n "$json" ]; then
    jq -c --arg name "$1" --arg fork "$3/${2#*/}" --arg upstream "$2" \
      '{name: $name, fork: $fork, upstream: $upstream, behind: .ahead_by, ahead: .behind_by,
        merge_base: .merge_base_commit.commit.committer.date}' <<<"$json" >>"$tmp/forks"
  else
    gap "compare-$1: no answer from the GitHub compare API for $2"
    jq -nc --arg name "$1" --arg fork "$3/${2#*/}" --arg upstream "$2" \
      '{name: $name, fork: $fork, upstream: $upstream, behind: null, ahead: null, merge_base: null}' >>"$tmp/forks"
  fi
}

# --- doctor -----------------------------------------------------------------
doctor_status=0
set +e
doctor_out="$(source_ doctor "$here/doctor")"; doctor_status=$?
set -e
[ "$doctor_status" -eq 2 ] && gap "doctor: exit 2, an input it needs is missing"

# --- versions ---------------------------------------------------------------
github_release no-mistakes nm kunchenguid/no-mistakes no-mistakes "no-mistakes update"
github_release treehouse th kunchenguid/treehouse treehouse "treehouse update"

cursor="$(source_ cursor-version cursor-agent --version | head -n1 | tr -d '[:space:]')" || gap "cursor-version: cursor-agent --version gave nothing"
version cursor-agent installed-only "$cursor" "" "" "" "" ""

cswap_installed="$(source_ uv-tools uv tool list | awk '$1 == "claude-swap" { sub(/^v/, "", $2); print $2 }')" || gap "uv-tools: uv tool list gave nothing"
cswap_latest="" cswap_released=""
if pypi="$(source_ pypi-claude-swap curl -fsS --max-time 20 https://pypi.org/pypi/claude-swap/json)" && [ -n "$pypi" ]; then
  cswap_latest="$(jq -r '.info.version // ""' <<<"$pypi")"
  cswap_released="$(jq -r '.releases[.info.version][0].upload_time_iso_8601 // ""' <<<"$pypi" | release_date)"
else
  gap "pypi-claude-swap: no answer from PyPI"
fi
version claude-swap pypi "$cswap_installed" "$cswap_latest" "$cswap_released" "" "https://pypi.org/project/claude-swap/" "cswap upgrade"

if casks="$(source_ casks brew info --cask --json=v2 claude-code@latest codex)" && [ -n "$casks" ]; then
  # Joined by the unit separator: an empty field between tabs would be swallowed by read.
  while IFS=$'\x1f' read -r token installed latest; do
    version "$token" cask "$installed" "$latest" "" "" "" "brew upgrade --cask $token"
  done < <(jq -r '.casks[] | [.token, (.installed // ""), (.version // "")] | join("\u001f")' <<<"$casks")
else
  gap "casks: brew info gave nothing for the claude-code@latest and codex casks"
fi

if npm_ls="$(source_ npm-ls npm ls -g --json --depth=0)" && [ -n "$npm_ls" ]; then
  if outdated="$(npm_outdated)" && jq -e 'type == "object" and (has("error") | not)' <<<"$outdated" >/dev/null 2>&1; then :
  else
    outdated=null
    gap "npm-outdated: npm outdated failed or returned no valid result"
  fi
  while IFS=$'\x1f' read -r pkg installed latest; do
    version "$pkg" npm "$installed" "$latest" "" "" "https://www.npmjs.com/package/$pkg" "npm install -g $pkg@latest"
  done < <(jq -r --argjson out "$outdated" \
    '.dependencies // {} | to_entries[] | [.key, .value.version, (if $out == null then null else ($out[.key].latest // .value.version) end)] | join("\u001f")' <<<"$npm_ls")
else
  gap "npm-ls: npm ls -g gave nothing"
fi

# --- forks ------------------------------------------------------------------
fork dotfiles kunchenguid/dotfiles revvu
fork firstmate kunchenguid/firstmate revvu

# --- policy references ------------------------------------------------------
if [ -r "$policy" ]; then
  policy="$(cd "$(dirname "$policy")" && pwd)/$(basename "$policy")"
  # shellcheck disable=SC2016  # the pattern is a regex, not an expansion
  grep -oE '(~/[^[:space:]`)>",]+|https?://[^[:space:]`)>",]+)' "$policy" | sort -u | while read -r ref; do
    ok=false
    if [ "${ref#\~/}" != "$ref" ]; then
      kind="path"
      [ -e "$home/${ref#\~/}" ] && ok=true
    else
      kind="link"
      curl -fsSIL --max-time 20 -o /dev/null "$ref" && ok=true
    fi
    jq -nc --arg ref "$ref" --arg kind "$kind" --argjson ok "$ok" '{ref: $ref, kind: $kind, ok: $ok}' >>"$tmp/policy"
  done || true # grep exits 1 when the policy has no references at all
else
  gap "policy: cannot read $policy"
fi

# --- assemble ---------------------------------------------------------------
jq -n \
  --arg host "$(/usr/sbin/scutil --get LocalHostName 2>/dev/null || hostname -s)" \
  --arg generated_at "$(date -r "$now" +%Y-%m-%dT%H:%M:%S%z)" \
  --arg date "$(date -r "$now" +%F)" \
  --argjson doctor_status "$doctor_status" \
  --arg doctor_out "$doctor_out" \
  --arg policy "$policy" \
  --slurpfile versions "$tmp/versions" \
  --slurpfile forks "$tmp/forks" \
  --slurpfile policy_refs "$tmp/policy" \
  --slurpfile errors "$tmp/errors" \
  '{host: $host, generated_at: $generated_at, date: $date,
    doctor: {status: $doctor_status, output: $doctor_out},
    versions: $versions, forks: $forks,
    policy: {file: $policy, refs: $policy_refs},
    errors: $errors}'

[ -s "$tmp/errors" ] && exit 1
exit 0
